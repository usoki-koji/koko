{
  "schemaVersion": 1,
  "id": "koko",
  "version": "1.0.0",
  "name": "Koko",
  "description": "Koko is a modular mod that allows you to add your own skills, their xp sources and effects.",
  "authors": ["Koji Usoki"],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/koko/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.koji.fabric.FabricKoko"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.koji.fabric.client.FabricKokoClient"
      }
    ]
  },
  "mixins": [
    "koko.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.0+kotlin.2.1.0"
  },
  "suggests": {
    "another-mod": "*"
  }
}
